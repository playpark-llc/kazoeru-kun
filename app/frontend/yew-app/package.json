{
  "dependencies": {
    "tailwindcss": "^3.4.3"
  },
  "scripts": {
    "dev": "npm run dev:css & npm run dev:serve",
    "dev:css": "tailwindcss -i ./static/css/app.css -o ./static/css/tailwind.css --watch",
    "dev:serve": "cargo clean && trunk serve --address 0.0.0.0",
    "prod": "npm run prod:css && trunk build --release",
    "prod:css": "tailwindcss -c tailwind.config.js -o tailwind.css --minify",
    "deploy": "npx wrangler pages deploy",
    "build:deploy": "npm run prod && npm run deploy",
    "build:cloudflare": "cargo install trunk --locked && npm run prod"
  }
}
