# Production Environment Variables Template for Backend
# Copy this to .env.production and fill in actual values

# Database Configuration
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:6432/postgres
# For local testing: postgresql://postgres:admin_password@db:5432/kazoerukun
DATABASE_URL=postgresql://postgres:admin_password@db:5432/kazoerukun

# Redis Configuration
# For Upstash: redis://default:[PASSWORD]@[ENDPOINT].upstash.io:6379
# For local testing: redis://redis:6379
REDIS_URL=redis://redis:6379

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3001

# Application Settings
TARGET_VALUE=10

# Rocket Secret Key (REQUIRED for production)
# Generate with: openssl rand -base64 32
ROCKET_SECRET_KEY=CHANGEME_generate_with_openssl_rand_base64_32

# Cron Job Intervals (in seconds)
SYNC_JOB_INTERVAL_SECS=60                # Redis to PostgreSQL sync
STATUS_HISTORY_JOB_INTERVAL_SECS=86400   # Status history update (24 hours)