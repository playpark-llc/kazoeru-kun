# PostgreSQL configuration
DATABASE_URL="postgresql://postgres:your_password@db:5432/kazoerukun"

# Alpine Linux library paths (required for musl builds)
LIBRARY_PATH=/usr/lib:/usr/local/lib
LD_LIBRARY_PATH=/usr/lib:/usr/local/lib
RUSTFLAGS="-C link-arg=-L/usr/local/lib"

# Redis configuration
REDIS_URL="redis://redis:6379"

# CORS configuration - add your allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,https://example.com

# Target value for weekly status calculation (default: 100000)
TARGET_VALUE=10

# Cron job intervals (in seconds)
# Sync job: Redis to PostgreSQL synchronization
SYNC_JOB_INTERVAL_SECS=60  # 1 minute (production default)

# Status history job: Weekly status calculation
STATUS_HISTORY_JOB_INTERVAL_SECS=86400  # 24 hours (1 day)

# Test database URL (optional, for running tests)
# TEST_DATABASE_URL="postgresql://postgres:test@localhost/test_db"