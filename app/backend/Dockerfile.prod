# ======================================
# Stage 1: Builder
# ======================================
FROM rust:1.83.0-bookworm AS builder

# Install dependencies
RUN apt-get update && \
    apt-get install -y pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy dependency files first for better caching
COPY Cargo.toml Cargo.lock ./
COPY rust-toolchain.toml ./

# Create dummy main.rs to build dependencies
RUN mkdir src && \
    echo "fn main() {}" > src/main.rs && \
    cargo build --release && \
    rm -rf src

# Copy actual source code
COPY src ./src
COPY migration ./migration
COPY .env ./

# Build the actual application
RUN touch src/main.rs && \
    cargo build --release

# ======================================
# Stage 2: Runtime
# ======================================
FROM debian:bookworm-slim

# Install runtime dependencies including OpenSSL 3 and MySQL client
RUN apt-get update && \
    apt-get install -y \
    libssl3 \
    ca-certificates \
    libmariadb3 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -m -u 1001 -s /bin/bash appuser

# Set working directory
WORKDIR /app

# Copy the binary from builder
COPY --from=builder /build/target/release/opt /app/backend
COPY --from=builder /build/.env /app/.env

# Copy Rocket configuration
COPY Rocket.toml /app/Rocket.toml

# Copy production entrypoint script
COPY entrypoint-prod.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Change ownership to non-root user
RUN chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8881

# Run the application
CMD ["/app/entrypoint.sh"]